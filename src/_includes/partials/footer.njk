<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="{{ t.home }}">
        <img class="brand-mark" src="/assets/img/logo-mark-light.png" alt="" width="72" height="44">
        <span class="brand-lockup">
          <span class="brand-word">{{ t.siteName }}</span>
          <span class="brand-alt" aria-hidden="true">{% if lang == "ar" %}JISR{% else %}جسر{% endif %}</span>
        </span>
      </a>
      <p class="footer-tagline">{{ t.footerTagline }}</p>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>{{ t.footerNavTitle }}</h4>
        <a href="{{ t.home }}">{{ t.nav.home }}</a>
        <a href="{{ t.manifestoUrl }}">{{ t.nav.manifesto }}</a>
        <a href="{{ t.articlesUrl }}">{{ t.nav.articles }}</a>
        <a href="{{ t.joinUrl }}">{{ t.nav.join }}</a>
        <a href="{{ t.contactUrl }}">{{ t.nav.contact }}</a>
      </div>
      <div class="footer-col">
        <h4>{{ t.footerLangTitle }}</h4>
        <a href="{{ langLinks.fr }}" hreflang="fr" lang="fr">Français</a>
        <a href="{{ langLinks.en }}" hreflang="en" lang="en">English</a>
        <a href="{{ langLinks.ar }}" hreflang="ar" lang="ar">العربية</a>
      </div>
    </div>
  </div>
  <div class="container">
    <div class="footer-bottom">
      <span>&copy; {% year %} {{ t.rights }}</span>
      <a href="{{ t.privacyUrl }}">{{ t.privacyLabel }}</a>
    </div>
  </div>
</footer>
